{
  "manifest_version": 3,
  "name": "GPT AntiCurse",
  "version": "0.4.2",
  "description": "Makes very long ChatGPT conversations responsive by shrinking invisible conversation state before page JavaScript processes it.",
  "permissions": ["storage", "webRequest", "webRequestBlocking", "webRequestFilterResponse"],
  "host_permissions": ["https://chatgpt.com/*"],
  "background": { "scripts": ["trim.js", "background.js"] },
  "content_scripts": [{
    "matches": ["https://chatgpt.com/*"],
    "js": ["content.js", "windowed.js"],
    "css": ["content.css", "windowed.css"],
    "run_at": "document_start"
  }],
  "action": { "default_title": "GPT AntiCurse", "default_popup": "popup.html" },
  "browser_specific_settings": {
    "gecko": {
      "id": "gpt-anticurse@mistrjirka",
      "strict_min_version": "128.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  }
}
