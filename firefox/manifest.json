{
  "manifest_version": 3,
  "name": "GPT AntiCurse",
  "version": "0.5.7",
  "description": "Makes very long ChatGPT conversations responsive by shrinking invisible conversation state before page JavaScript processes it.",
  "permissions": ["storage", "webRequest", "webRequestBlocking", "webRequestFilterResponse", "unlimitedStorage"],
  "host_permissions": ["https://chatgpt.com/*"],
  "background": {
    "scripts": ["defaults.js", "trim.js", "archive.js", "archive-export.js", "archive-store.js", "archive-background.js", "archive-firefox-hook.js", "background.js"]
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["archive.js", "content.js", "history-overlay.js", "history-native.js", "windowed.js", "archive-capture.js"],
      "css": ["content.css"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "GPT AntiCurse",
    "default_popup": "popup.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "gpt-anticurse@mistrjirka",
      "strict_min_version": "128.0",
      "data_collection_permissions": {"required": ["none"]}
    }
  }
}
