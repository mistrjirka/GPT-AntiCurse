{
  "manifest_version": 3,
  "name": "GPT AntiCurse",
  "version": "0.7.3",
  "description": "Makes very long ChatGPT conversations responsive and automatically recovers stalled runs.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "webRequest",
    "webRequestBlocking",
    "webRequestFilterResponse"
  ],
  "host_permissions": [
    "https://chatgpt.com/*"
  ],
  "background": {
    "scripts": [
      "conversation-endpoint.js",
      "diagnostics.js",
      "trim.js",
      "trim-logical.js",
      "trim-pipeline.js",
      "pagination-firewall.js",
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "dom-ready.js",
        "diagnostics.js",
        "conversation-scope.js",
        "content.js",
        "history-markdown.js",
        "history-virtualized.js",
        "history-fidelity.js",
        "history-hydration-safe.js",
        "history-overlay.js",
        "export-extract.js",
        "session-auth.js",
        "archive-capture.js",
        "stall-recovery.js",
        "windowed.js",
        "debug-state.js"
      ],
      "css": [
        "content.css",
        "history-virtualized.css",
        "history-fidelity.css",
        "android.css"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "GPT AntiCurse",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "gpt-anticurse@mistrjirka",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {}
  }
}
