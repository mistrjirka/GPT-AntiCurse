{
  "manifest_version": 3,
  "name": "GPT AntiCurse",
  "version": "0.5.17",
  "description": "Makes very long ChatGPT conversations responsive by shrinking invisible conversation state before page JavaScript processes it.",
  "permissions": ["storage", "webRequest", "webRequestBlocking", "webRequestFilterResponse", "unlimitedStorage"],
  "host_permissions": ["https://chatgpt.com/*"],
  "background": {
    "scripts": ["diagnostics.js", "trim.js", "trim-logical.js", "archive.js", "archive-export.js", "archive-store.js", "archive-background.js", "background.js"]
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["dom-ready.js", "diagnostics.js", "archive.js", "content.js", "history-native.js", "history-virtualized.js", "history-fidelity.js", "history-hydration-safe.js", "archive-capture.js", "windowed.js", "debug-state.js"],
      "css": ["content.css", "history-virtualized.css", "history-fidelity.css"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "GPT AntiCurse",
    "default_popup": "popup.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "gpt-anticurse@mistrjirka",
      "strict_min_version": "128.0",
      "data_collection_permissions": {"required": ["none"]}
    }
  }
}
