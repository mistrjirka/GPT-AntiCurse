{
  "manifest_version": 3,
  "name": "GPT AntiCurse",
  "version": "0.7.11",
  "description": "Makes very long ChatGPT conversations responsive and automatically recovers stalled runs.",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://chatgpt.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "conversation-endpoint.js",
        "message-visibility.js",
        "trim.js",
        "trim-logical.js",
        "trim-pipeline.js",
        "pagination-firewall.js",
        "main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "dom-ready.js",
        "diagnostics.js",
        "conversation-scope.js",
        "delivery-timeout-reload.js",
        "recovery-status-ui.js",
        "content.js",
        "history-markdown.js",
        "history-virtualized.js",
        "history-fidelity.js",
        "history-hydration-safe.js",
        "history-overlay.js",
        "message-visibility.js",
        "export-extract.js",
        "session-auth.js",
        "history-artifacts.js",
        "archive-capture.js",
        "composer-native-input.js",
        "recovery-reload-state.js",
        "pro-recovery-guard.js",
        "recovery-policy.js",
        "stall-recovery.js",
        "windowed.js",
        "debug-state.js"
      ],
      "css": [
        "content.css",
        "history-virtualized.css",
        "history-fidelity.css"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ],
  "action": {
    "default_title": "GPT AntiCurse",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background-entry.js"
  }
}
