{
  "manifest_version": 3,
  "name": "GPT AntiCurse",
  "version": "0.5.7",
  "description": "Makes very long ChatGPT conversations responsive by shrinking invisible conversation state before page JavaScript processes it.",
  "minimum_chrome_version": "111",
  "permissions": ["storage", "tabs", "unlimitedStorage"],
  "host_permissions": ["https://chatgpt.com/*"],
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["trim.js", "archive.js", "main-settings-barrier.js", "history-replay-main.js", "main.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["archive-settings-bridge.js", "archive.js", "content.js", "history-overlay.js", "history-native.js", "windowed.js", "history-request.js", "archive-capture.js"],
      "css": ["content.css"],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ],
  "action": {"default_title": "GPT AntiCurse", "default_popup": "popup.html"},
  "background": {"service_worker": "background-entry.js"}
}
