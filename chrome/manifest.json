{
  "manifest_version": 3,
  "name": "GPT AntiCurse",
  "version": "0.5.13",
  "description": "Makes very long ChatGPT conversations responsive by shrinking invisible conversation state before page JavaScript processes it.",
  "minimum_chrome_version": "111",
  "permissions": ["storage", "tabs", "unlimitedStorage"],
  "host_permissions": ["https://chatgpt.com/*"],
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["trim.js", "trim-logical.js", "archive.js", "main.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["dom-ready.js", "diagnostics.js", "archive.js", "content.js", "history-native.js", "history-virtualized.js", "history-fidelity.js", "history-hydration-safe.js", "archive-capture.js", "windowed.js"],
      "css": ["content.css", "history-virtualized.css", "history-fidelity.css"],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ],
  "action": {"default_title": "GPT AntiCurse", "default_popup": "popup.html"},
  "background": {"service_worker": "background-entry.js"}
}
